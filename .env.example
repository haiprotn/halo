# ===== Kết nối cơ sở dữ liệu =====
# Định dạng: postgresql+psycopg://<user>:<mật khẩu>@<host>:<cổng>/<tên csdl>
DATABASE_URL=postgresql+psycopg://halo:doi_mat_khau_nay@localhost:5432/halo

# ===== Khóa bí mật =====
# APP_KEY: 64 ký tự hex (32 byte) dùng cho AES-256-GCM mã hóa mật khẩu router.
#   MẤT KHÓA NÀY LÀ KHÔNG GIẢI MÃ LẠI ĐƯỢC → sao lưu .env cùng với bản dump CSDL.
#   Sinh khóa mới: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_KEY=
# SESSION_SECRET: ký cookie phiên đăng nhập. Đổi khóa này = đá mọi người ra, không mất dữ liệu.
SESSION_SECRET=

# ===== Mạng WireGuard =====
WG_PREFIX=10.90.0.
VPS_WG_IP=10.90.0.1
# Phải khớp với ListenPort trong /etc/wireguard/wg0.conf VÀ luật UFW
WG_PORT=51820

# ===== Cam kết dữ liệu (đọc kỹ trước khi đổi) =====
# COLLECT_SESSIONS=true là BẮT ĐẦU LƯU chi tiết từng phiên của khách.
# Bật lên thì PHẢI sửa mục "luồng dữ liệu" trong bản thuyết minh Word gửi khách hàng,
# vì câu "dữ liệu không rời khỏi khuôn viên" không còn đúng nữa.
COLLECT_SESSIONS=false
HASH_MAC=true

# ===== Tác vụ nền =====
MONITOR_INTERVAL=60
MONITOR_TIMEOUT=8
SFTP_TIMEOUT=30

# ===== Giới hạn banner =====
# Flash router là tài nguyên khan hiếm (hEX còn ~5,7 MiB) → chặn ngay từ tầng VPS.
MAX_BANNER_BYTES=153600
MAX_BANNERS_PER_SITE=8
